# Chave do Google Gemini (Google AI Studio `AIzaSy...` ou Vertex AI `AQ....`)
GEMINI_API_KEY=cole_sua_chave_aqui

# Opcional: substitui o modelo usado pelo agente no painel
# OPS_AGENTE_MODELO=gemini-3.5-flash-lite

# Opcional: força o modo (gemini | demo). Sem chave, o modo demo é automático.
# OPS_AGENTE_MODO=gemini

# Opcional: chaves AQ. usam AI Studio por padrão; 1 força Vertex AI
# GEMINI_USAR_VERTEX=0
